#include <windows.h>
#include "resource.h"
IDI_USB_MIRROR ICON "assets/USBMirror.ico"

1 VERSIONINFO
 FILEVERSION 0,4,2,0
 PRODUCTVERSION 0,4,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "USB Mirror"
   VALUE "FileVersion", "0.4.2"
   VALUE "ProductName", "USB Mirror"
   VALUE "ProductVersion", "0.4.2"
   VALUE "LegalCopyright", "GPL-3.0-only"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

#ifdef USB_MIRROR_DRIVER
IDR_FILTER_TOOL RCDATA "third_party/capture-engine/src/DriverInstaller/Assets/libusb-win32-1.2.6.0/amd64/install-filter.exe"
IDR_FILTER_DRIVER RCDATA "third_party/capture-engine/src/DriverInstaller/Assets/libusb-win32-1.2.6.0/amd64/libusb0.sys"
IDR_FILTER_DLL64 RCDATA "third_party/capture-engine/src/DriverInstaller/Assets/libusb-win32-1.2.6.0/amd64/libusb0.dll"
IDR_FILTER_DLL32 RCDATA "third_party/capture-engine/src/DriverInstaller/Assets/libusb-win32-1.2.6.0/x86/libusb0_x86.dll"
#endif

#ifdef USB_MIRROR_BUNDLE
IDR_APP_BUNDLE RCDATA "build/USBMirror.bundle"
#endif
